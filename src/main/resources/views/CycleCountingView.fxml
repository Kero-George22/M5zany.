<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" styleClass="main-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.smartstock.controller.CycleCountingController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Cycle Counting" styleClass="header-label">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="branchLabel" text="Branch: -"/>
        <Label fx:id="dateLabel" text="Date: -"/>
    </HBox>
    
    <!-- Statistics Panel -->
    <VBox spacing="10" styleClass="stats-panel">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Label text="Cycle Count Statistics" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <HBox spacing="20">
            <VBox spacing="5">
                <Label text="Total Counts:" styleClass="stat-label"/>
                <Label fx:id="totalCountsLabel" text="0" styleClass="stat-value">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="5">
                <Label text="Discrepancies:" styleClass="stat-label"/>
                <Label fx:id="discrepanciesLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #e74c3c;">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="5">
                <Label text="Accuracy Rate:" styleClass="stat-label"/>
                <Label fx:id="accuracyRateLabel" text="0%" styleClass="stat-value" style="-fx-text-fill: #27ae60;">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
            </VBox>
            <VBox spacing="5">
                <Label text="Last Count:" styleClass="stat-label"/>
                <Label fx:id="lastCountLabel" text="-" styleClass="stat-value">
                    <font>
                        <Font name="System" size="14"/>
                    </font>
                </Label>
            </VBox>
        </HBox>
    </VBox>
    
    <!-- Daily Count List -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Today's Count List" styleClass="section-label">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Label>
            <Button text="Suggest Products" onAction="#handleSuggest" styleClass="primary-button"/>
            <Button text="Check-off Selected" onAction="#handleCheckOff" styleClass="secondary-button"/>
            <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
        </HBox>
        
        <TableView fx:id="countListTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="productIdColumn" text="Product ID" prefWidth="100"/>
                <TableColumn fx:id="productNameColumn" text="Product Name" prefWidth="200"/>
                <TableColumn fx:id="expectedQtyColumn" text="Expected Qty" prefWidth="120"/>
                <TableColumn fx:id="countedQtyColumn" text="Counted Qty" prefWidth="120"/>
                <TableColumn fx:id="discrepancyColumn" text="Discrepancy" prefWidth="120"/>
                <TableColumn fx:id="notesColumn" text="Notes" prefWidth="200"/>
                <TableColumn fx:id="actionColumn" text="Action" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
    
    <!-- Count Entry Panel -->
    <VBox spacing="10" styleClass="entry-panel">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>
        <Label text="Record Count" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <GridPane hgap="10" vgap="10">
            <Label text="Product:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="productComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>
            
            <Label text="Expected Qty:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="expectedQtyField" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="100" editable="false"/>
            
            <Label text="Counted Qty:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="countedQtyField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="100"/>
            
            <Label text="Notes:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="notesField" GridPane.columnIndex="3" GridPane.rowIndex="1" prefWidth="200"/>
            
            <Button text="Save Count" onAction="#handleSaveCount" GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.rowSpan="2" styleClass="primary-button"/>
        </GridPane>
    </VBox>
    
    <!-- History Panel -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Recent Count History" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>
        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="historyDateColumn" text="Date" prefWidth="120"/>
                <TableColumn fx:id="historyProductColumn" text="Product" prefWidth="200"/>
                <TableColumn fx:id="historyExpectedColumn" text="Expected" prefWidth="100"/>
                <TableColumn fx:id="historyCountedColumn" text="Counted" prefWidth="100"/>
                <TableColumn fx:id="historyDiscrepancyColumn" text="Discrepancy" prefWidth="100"/>
                <TableColumn fx:id="historyCountedByColumn" text="Counted By" prefWidth="150"/>
                <TableColumn fx:id="historyNotesColumn" text="Notes" prefWidth="200"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
